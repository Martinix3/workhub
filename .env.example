# WorkHub Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SERVICIOS EXTERNOS
# =============================================================================

# Frappe/ERPNext
FRAPPE_BASE_URL=http://localhost:7312
FRAPPE_PUBLIC_BASE_URL=http://localhost:7312

# Leantime
LEANTIME_BASE_URL=http://localhost:7313
LEANTIME_PUBLIC_BASE_URL=http://localhost:7313

# =============================================================================
# AUTENTICACIÓN
# =============================================================================

# Frappe API Token (formato: api_key:api_secret)
FRAPPE_API_TOKEN=<api_key>:<api_secret>

# Leantime Personal Access Token
LEANTIME_API_KEY=<personal_access_token>

# Leantime Owner Key (opcional, para operaciones admin)
LEANTIME_OWNER_KEY=

# =============================================================================
# MODOS DE OPERACIÓN
# =============================================================================

# mock = datos simulados, live = conexión real
FRAPPE_MODE=mock
LEANTIME_MODE=mock

# =============================================================================
# LEANTIME DEFAULTS
# =============================================================================

LEANTIME_DEFAULT_PROJECT_ID=1
LEANTIME_DEFAULT_CLIENT_ID=1

# =============================================================================
# SYNC WORKER (opcional)
# =============================================================================

POLL_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=21600
LIMIT=300
TERM=WorkLinkId:
