{
  "name": "workhub-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --config=playwright.config.ts --grep=@visual",
    "test:visual:update": "playwright test --config=playwright.config.ts --grep=@visual --update-snapshots",
    "test:lighthouse": "playwright test --config=playwright.config.ts --grep=@lighthouse",
    "test:lighthouse:update": "playwright test --config=playwright.config.ts --grep=@lighthouse --update-snapshots",
    "review:pre-deploy": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts",
    "review:pre-deploy:ralph": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --ralph",
    "review:phase0": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --phase=0",
    "review:phase1": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --phase=1",
    "review:phase2": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --phase=2",
    "review:phase3": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --phase=3",
    "review:phase4": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --phase=4",
    "review:phase5": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --phase=5",
    "review:dry-run": "npx ts-node --project ../scripts/tsconfig.json ../scripts/pre-deploy-review.ts --dry-run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "knip": "^5.82.1",
    "playwright-lighthouse": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
