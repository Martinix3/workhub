# Frappe Backend Configuration
VITE_FRAPPE_URL=http://localhost:8000

# Google OAuth (for authentication)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Authentication Bypass (Development Only)
# WARNING: Never enable this in production! This allows bypassing authentication
# for UI testing and development. Set to 'true' only in local development environments.
# Default: false (disabled for security)
VITE_ENABLE_AUTH_BYPASS=false

# App Mode (development, production)
VITE_APP_MODE=development
