{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["web/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../config/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
